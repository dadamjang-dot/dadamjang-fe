{
  "name": "@dadamjang/fo",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "storybook": "STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "ios": "expo run:ios",
    "build:development": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "verify:config": "expo config --type public",
    "nosync": "npx nosync-icloud && npx nosync-icloud -f .expo",
    "test": "jest --runInBand",
    "test:android": "jest --config jest.android.config.ts --runInBand",
    "test:unit": "jest __tests__/unit --runInBand",
    "test:integration": "jest __tests__/integration --runInBand",
    "verify:android-export": "sh ./scripts/smoke-android-public-graph.sh"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.0",
    "@dadamjang/design-tokens": "workspace:*",
    "@dadamjang/domain": "workspace:*",
    "@dadamjang/graphql-client": "workspace:*",
    "@dadamjang/mobile": "workspace:*",
    "@expo/ui": "~57.0.0",
    "@legendapp/list": "^3.3.2",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^55.0.10",
    "@react-native/jest-preset": "^0.86.2",
    "@storybook/react-native": "9.1.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.1",
    "graphql-request": "^7.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "storybook": "9.1.20",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  }
}
