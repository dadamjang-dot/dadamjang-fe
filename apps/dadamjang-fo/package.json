{
  "name": "@dadamjang/fo",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "storybook": "STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "ios": "expo run:ios",
    "build:development": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "verify:config": "expo config --type public",
    "nosync": "npx nosync-icloud && npx nosync-icloud -f .expo",
    "test": "jest --runInBand --runTestsByPath $(find __tests__ src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print)",
    "test:android": "jest --config jest.android.config.ts --runInBand",
    "test:unit": "jest --runInBand --runTestsByPath $(find __tests__/unit src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print)",
    "test:integration": "jest --runInBand --runTestsByPath $(find __tests__/integration -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print)",
    "verify:android-export": "sh ./scripts/smoke-android-public-graph.sh"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.0",
    "@dadamjang/design-tokens": "workspace:*",
    "@dadamjang/domain": "workspace:*",
    "@dadamjang/graphql-client": "workspace:*",
    "@dadamjang/mobile": "workspace:*",
    "@legendapp/list": "^3.3.2",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "graphql": "16.14.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@storybook/react-native": "9.1.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "storybook": "9.1.20",
    "typescript": "~6.0.3"
  }
}
